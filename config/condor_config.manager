CONDOR_HOST = $(IP_ADDRESS)
COLLECTOR_HOST = condor-manager:9618
CONDOR_ADMIN = root@condor-manager
DAEMON_LIST = MASTER, COLLECTOR, NEGOTIATOR, SCHEDD, STARTD
NETWORK_INTERFACE = *
CONDOR_IDS = 0.0
COLLECTOR_PORT = 9618
NEGOTIATOR_PORT = 9701
SCHEDD_PORT = 1119
STARTD_PORT = 9702
SPOOL = /var/lib/condor/spool
EXECUTE = /var/lib/condor/execute
LOCK = /var/lib/condor/lock
LOG = /var/log/condor
SCHEDD_NAME = condor-manager@condor-manager
SCHEDD_HOST = condor-manager
SCHEDD_ADDRESS_FILE = /var/lib/condor/spool/.schedd_address
START = TRUE
SUSPEND = FALSE
PREEMPT = FALSE
KILL = FALSE
MAX_NUM_RUNNING_DAEMONS = 1
QUEUE_SUPER_USERS = root@*, condor@*
SEC_DEFAULT_AUTHENTICATION = OPTIONAL
SEC_DEFAULT_ENCRYPTION = OPTIONAL
SEC_DEFAULT_INTEGRITY = OPTIONAL
SEC_DEFAULT_NEGOTIATION = OPTIONAL
SEC_READ_WRITE_CONFIG = *
ALLOW_READ = *
ALLOW_WRITE = *
ALLOW_DAEMON = *
ALLOW_ADVERTISE_STARTD = *
ALLOW_ADVERTISE_MASTER = *
UPDATE_INTERVAL = 5
NEGOTIATOR_INTERVAL = 5
NEGOTIATOR_CYCLE_DELAY = 5
STARTD_UPDATE_INTERVAL = 5
COLLECTOR_UPDATE_INTERVAL = 5
SCHEDD_INTERVAL = 5
USE_SHARED_PORT = FALSE
BIND_ALL_INTERFACES = TRUE
