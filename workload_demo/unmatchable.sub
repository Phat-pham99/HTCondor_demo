# Queued scenario: no compute node offers 1 TB of memory, so the job stays IDLE.
executable = monte_carlo_pi.py
arguments = --samples 250000 --seed 3 --output queued-$(ClusterId)-$(ProcId).json
transfer_input_files = monte_carlo_pi.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = queued-$(ClusterId)-$(ProcId).json
output_directory = /out
output = /out/queued-$(ClusterId)-$(ProcId).log
error = /out/queued-$(ClusterId)-$(ProcId).err
request_memory = 1048576
queue 1
