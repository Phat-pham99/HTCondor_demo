# Failure scenario: --samples 0 makes the workload raise and exit with code 1.
executable = monte_carlo_pi.py
arguments = --samples 0 --seed 1 --output fail-$(ClusterId)-$(ProcId).json
transfer_input_files = monte_carlo_pi.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
output_directory = /out
output = /out/fail-$(ClusterId)-$(ProcId).log
error = /out/fail-$(ClusterId)-$(ProcId).err
queue 1
