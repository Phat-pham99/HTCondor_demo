executable = monte_carlo_pi.py
arguments = --samples 250000 --seed $(ClusterId) --output pi-$(ClusterId).json
transfer_input_files = monte_carlo_pi.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = pi-$(ClusterId).json
output_directory = /out
output = /out/pi-$(ClusterId).log
error = /out/pi-$(ClusterId).err
queue 4
